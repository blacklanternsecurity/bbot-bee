# syntax=docker/dockerfile:1.7
# Dev drone — single stage, source volume-mounted at runtime.
# The venv is at /venv-dev (a named Docker volume) so it persists
# across restarts without being overwritten by the source mount.
FROM ghcr.io/astral-sh/uv:0.7-python3.12-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git openssh-client curl jq \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/venv-dev
ENV GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new"

WORKDIR /app/bbot_bee

# Install deps into the dev venv. bbot-swarm-common (private) is pulled over SSH
# via the forwarded agent (`docker build --ssh default ...`).
COPY pyproject.toml uv.lock ./
RUN --mount=type=ssh uv sync --frozen --no-install-project

COPY . ./
RUN --mount=type=ssh uv sync --frozen

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
